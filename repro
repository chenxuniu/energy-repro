    value = {"schema": "energy-repro/run-state/v1", "state": state, **extra}
    atomic_json(run_root / "state.json", value)


def execution_outcome(returncode: int) -> tuple[str, int]:
    interrupt_codes = {
        -int(signal.SIGINT),
        -int(signal.SIGTERM),
        128 + int(signal.SIGINT),
        128 + int(signal.SIGTERM),
    }
    if returncode in interrupt_codes:
        return "interrupted", 130 if returncode in {-int(signal.SIGINT), 128 + int(signal.SIGINT)} else 143
    return ("succeeded", 0) if returncode == 0 else ("failed", EXIT_EXEC)


def finalize_run_manifest(
    run_root: Path,
    manifest: dict[str, Any],
    state: str,
    exit_code: int,
    **state_details: Any,
) -> None:
    manifest["state"] = state
    manifest["exit_code"] = exit_code
    manifest["timestamps"]["finished_at"] = utc_now()
    manifest["artifacts"] = artifact_inventory(run_root)
    atomic_json(run_root / "manifest.json", manifest)
    write_run_state(
        run_root,
        state,
        exit_code=exit_code,
        finished_at=manifest["timestamps"]["finished_at"],
        **state_details,
    )


def execute_logged(argv: list[str], log_path: Path) -> int:
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with log_path.open("a", encoding="utf-8", buffering=1) as log:
        process = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        old_handlers: dict[int, Any] = {}

        def forward(signum: int, _frame: Any) -> None:
            if process.poll() is None:
                process.send_signal(signum)

        for signum in (signal.SIGINT, signal.SIGTERM):
            old_handlers[signum] = signal.signal(signum, forward)
        try:
            assert process.stdout is not None
            for line in process.stdout:
                log.write(line)
                print(line, end="")
            return process.wait()
        finally:
            for signum, handler in old_handlers.items():
                signal.signal(signum, handler)


def base_gpu_container(args: argparse.Namespace, ref: str) -> list[str]:
    return [
        args.runtime,
        "run",
        "--rm",
        "--network=none",
        *container_identity_args(),
        "--gpus",
        "device=0",
        "--ipc=host",
        "--ulimit",
        "memlock=-1",
    ]


def runtime_probe_argv(args: argparse.Namespace, ref: str) -> list[str]:
    command = [
        *base_gpu_container(args, ref),
        *docker_mount(profile_path(args.profile), "/inputs/profile.json", True),
    ]
    rapl_root = Path("/sys/class/powercap")
    if rapl_root.is_dir():
        command.extend(docker_mount(rapl_root, "/sys/class/powercap", True))
    command.extend(
        [
        ref,
        "python",
        "/opt/energy-repro/tools/runtime_probe.py",
        "--profile-file",
        "/inputs/profile.json",
        "--json",
        ]
    )
    return command


def existing_run_result(run_root: Path, plan: dict[str, Any]) -> dict[str, Any] | None:
    if not run_root.exists():
        return None
    existing_plan_path = run_root / "plan.json"
    if not existing_plan_path.is_file():
        raise ReproError(f"Run directory exists without a plan and will not be overwritten: {run_root}", EXIT_CONFLICT)
    existing = read_json(existing_plan_path)
    if existing.get("plan_sha256") != plan["plan_sha256"]:
        raise ReproError(f"Run ID collision with a different plan: {run_root}", EXIT_CONFLICT)
    state_path = run_root / "state.json"
    state = read_json(state_path).get("state") if state_path.is_file() else "planned"
    if state == "succeeded":
        return {"status": "NOOP", "run_id": plan["run_id"], "reason": "run already succeeded"}
    if state == "running":
        raise ReproError(f"Run is already active: {plan['run_id']}", EXIT_CONFLICT)
    if state in {"failed", "interrupted"}:
        raise ReproError(
            f"Run attempt is {state} and will not be overwritten; increment --attempt. "
            "Automatic resume is intentionally unsupported because the pinned trainer cannot resume exactly.",
            EXIT_CONFLICT,
        )
    return None


def command_smoke(args: argparse.Namespace) -> dict[str, Any]:
    profile = read_json(profile_path(args.profile))
    if "smoke" not in profile.get("runnable_stages", []):
        raise ReproError(f"Profile {args.profile} does not allow smoke", EXIT_POLICY)
    if args.kind == "pipeline" and not args.recipe:
        raise ReproError("--kind pipeline requires --recipe", EXIT_ARGS)
    recipe = read_json(recipe_path(args.recipe)) if args.recipe else None
    cache, runs, state_dir = resolved_dirs(args)
    ref, immutable = image_ref(args, state_dir, planning=args.dry_run)
    plan, run_id = deterministic_plan(profile, recipe if args.kind == "pipeline" else None, "smoke", 42, args.attempt, ref)
    run_root = runs / run_id
    if args.kind == "pipeline":
        planned_command = ["./repro", "run", "--recipe", args.recipe, "--stage", "student", "--dry-run"]
    else:
        planned_command = [
            *base_gpu_container(args, ref),
            *common_container_env(run_id),
            *docker_mount(runs, "/runs", False),
            ref,
            "python",
            "/opt/energy-repro/tools/telemetry_smoke.py",
            "--output",
            f"/runs/{run_id}/outputs/telemetry-smoke.json",
            "--duration-seconds",
            "10",
            "--sample-interval",
            "0.5",
        ]
    result = {
        "command": "smoke",
        "kind": args.kind,
        "profile": args.profile,
        "run_id": run_id,
        "run_root": str(run_root),
        "image": ref,
        "image_immutable": immutable,
        "plan": plan,
        "argv": planned_command,
    }
    if args.dry_run:
        return {"status": "PLANNED", "dry_run": True, **result, "deferred_checks": ["image", "GPU", "NVML"]}
    if args.kind == "pipeline":
        raise ReproError(
            "Pipeline smoke is intentionally not automated yet; it needs a separately audited tiny-step config. "
            "Use telemetry smoke, then an explicit formal stage.",
            EXIT_POLICY,
        )
    existing = existing_run_result(run_root, plan)
    if existing:
        return existing
    assert_gpu_idle()
    image_verification = verify_local_image(args, state_dir, ref)
    run_root.mkdir(parents=True)
    (run_root / "outputs").mkdir(parents=True)
    atomic_json(run_root / "plan.json", plan)
    manifest = initial_manifest(plan, profile, "planned", planned_command)
    manifest["image_verification"] = image_verification
    manifest["timestamps"]["created_at"] = utc_now()
    atomic_json(run_root / "manifest.json", manifest)
    write_run_state(run_root, "planned")
    probe = run_capture(runtime_probe_argv(args, ref), check=False)
    if probe.returncode:
        manifest["failure"] = {
            "phase": "runtime-probe",
            "subprocess_exit_code": probe.returncode,
            "detail": redact((probe.stdout + probe.stderr).strip()[:16000]),
        }
        finalize_run_manifest(run_root, manifest, "failed", EXIT_PREREQ, phase="runtime-probe")
        raise ReproError("Runtime GPU probe failed before smoke", EXIT_PREREQ, probe.stdout + probe.stderr)
    try:
        hardware = json.loads(probe.stdout)
    except json.JSONDecodeError:
        hardware = {"raw": probe.stdout.strip()}
    manifest["state"] = "running"
    manifest["hardware"] = hardware
    manifest["timestamps"]["started_at"] = utc_now()
    atomic_json(run_root / "manifest.json", manifest)
    write_run_state(run_root, "running", started_at=manifest["timestamps"]["started_at"])
    try:
        returncode = execute_logged(planned_command, run_root / "logs" / "telemetry-smoke.log")
    except KeyboardInterrupt:
        manifest["failure"] = {"phase": "execution", "detail": "interrupted by user"}
        finalize_run_manifest(run_root, manifest, "interrupted", 130, phase="execution")
        raise
    except OSError as exc:
        manifest["failure"] = {"phase": "execution", "detail": redact(str(exc))}
        finalize_run_manifest(run_root, manifest, "failed", EXIT_EXEC, phase="execution")
        raise ReproError("Could not launch telemetry smoke", EXIT_EXEC, str(exc)) from exc
    final_state, wrapper_exit_code = execution_outcome(returncode)
    finalize_run_manifest(run_root, manifest, final_state, returncode)
    if returncode:
        message = "Telemetry smoke was interrupted" if final_state == "interrupted" else "Telemetry smoke failed"
        raise ReproError(message, wrapper_exit_code, {"run_id": run_id, "exit_code": returncode})
    return {"status": "PASS", **result, "manifest": str(run_root / "manifest.json")}


def stage_module(recipe: dict[str, Any], stage: str) -> list[str]:
    if stage == "preprocess":
        tool = recipe.get("preprocess_tool")
        if tool is not None:
            if tool != "pilot_preprocess.py":
                raise ReproError(
                    f"Unsupported capsule preprocessing tool: {tool!r}",
                    EXIT_POLICY,
                )
            return ["python", f"/opt/energy-repro/tools/{tool}"]
        module = f"distill_bench.data.{recipe['preprocess_script']}"
        return ["python", "-m", module]
    if stage == "teacher":
        tool = recipe.get("teacher_tool")
        if tool is not None:
            if tool != "pilot_teacher.py":
                raise ReproError(
                    f"Unsupported capsule teacher tool: {tool!r}",
                    EXIT_POLICY,
                )
            return ["python", f"/opt/energy-repro/tools/{tool}"]
        module = f"distill_bench.data.{recipe['teacher_script']}"
        return ["python", "-m", module]
    if stage == "student":
        return ["python", "/opt/energy/run_experiment.py"]
    raise ReproError(f"No execution mapping for stage: {stage}", EXIT_POLICY)


