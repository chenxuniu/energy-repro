#!/usr/bin/env python3
"""Host-side launcher for the pinned StellarLuminosity/Energy capsule.

This file intentionally uses only the Python standard library.  It must remain
usable for planning and diagnostics on a fresh host before the OCI image exists.
"""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import hashlib
import json
import os
import platform
import re
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any, Iterable
from urllib.parse import unquote, urlparse


BUNDLE = Path(__file__).resolve().parent
SHA40 = re.compile(r"^[0-9a-f]{40}$")
SAFE_NAME = re.compile(r"^[a-z0-9][a-z0-9._-]{0,127}$")
SECRET_NAME = re.compile(r"(TOKEN|KEY|PASSWORD|SECRET|CREDENTIAL)", re.I)
PILOT_CLASSIFICATION = "workflow-pilot-not-paper-reproduction"
EXIT_ARGS = 2
EXIT_PREREQ = 3
EXIT_POLICY = 4
EXIT_EXEC = 5
EXIT_CONFLICT = 6


class ReproError(RuntimeError):
    def __init__(self, message: str, code: int = EXIT_EXEC, details: Any = None):
        super().__init__(message)
        self.code = code
        self.details = details


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ReproError(f"Cannot read valid JSON: {path}: {exc}", EXIT_ARGS) from exc
    if not isinstance(value, dict):
        raise ReproError(f"Expected a JSON object: {path}", EXIT_ARGS)
    return value


def canonical_bytes(value: Any) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n").encode("utf-8")


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def atomic_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(canonical_bytes(value))
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o640)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def redact(value: Any) -> Any:
    if isinstance(value, dict):
        return {key: ("<redacted>" if SECRET_NAME.search(str(key)) else redact(item)) for key, item in value.items()}
    if isinstance(value, list):
        return [redact(item) for item in value]
    if isinstance(value, str):
        value = re.sub(r"(?i)(hf_[A-Za-z0-9]{12,})", "<redacted>", value)
        value = re.sub(r"(?i)(token|password|secret|credential)=([^,\s]+)", r"\1=<redacted>", value)
    return value


def emit(args: argparse.Namespace, value: Any) -> None:
    safe = redact(value)
    if getattr(args, "json", False):
        print(json.dumps(safe, sort_keys=True, separators=(",", ":"), ensure_ascii=False))
    else:
        print(json.dumps(safe, indent=2, sort_keys=True, ensure_ascii=False))


def normalize_repo(url: str) -> str:
    return url.strip().removesuffix("/").removesuffix(".git").lower()


def run_capture(argv: list[str], cwd: Path | None = None, check: bool = True) -> subprocess.CompletedProcess[str]:
    try:
        result = subprocess.run(
            argv,
            cwd=cwd,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except FileNotFoundError as exc:
        raise ReproError(f"Required executable is not installed: {argv[0]}", EXIT_PREREQ) from exc
    if check and result.returncode:
        detail = (result.stderr or result.stdout).strip()
        raise ReproError(f"Command failed ({result.returncode}): {argv!r}: {detail}", EXIT_EXEC)
    return result


def safe_path(path: str | Path, label: str, *, allow_missing: bool = True) -> Path:
    raw = str(path)
    if not raw.strip():
        raise ReproError(f"{label} must not be empty", EXIT_ARGS)
    candidate = Path(raw).expanduser().resolve(strict=not allow_missing)
    if candidate == Path(candidate.anchor):
        raise ReproError(f"{label} must not be a filesystem root: {candidate}", EXIT_POLICY)
    return candidate


def under(child: Path, parent: Path) -> bool:
    try:
        child.resolve().relative_to(parent.resolve())
        return True
    except ValueError:
        return False


def profile_path(name: str) -> Path:
    if not SAFE_NAME.fullmatch(name):
        raise ReproError(f"Invalid profile name: {name!r}", EXIT_ARGS)
    path = BUNDLE / "profiles" / f"{name}.json"
    if not path.is_file():
        raise ReproError(f"Unknown profile: {name}", EXIT_ARGS)
    return path


def recipe_path(name: str) -> Path:
    if not SAFE_NAME.fullmatch(name):
        raise ReproError(f"Invalid recipe name: {name!r}", EXIT_ARGS)
    path = BUNDLE / "recipes" / f"{name}.json"
    if not path.is_file():
        raise ReproError(f"Unknown recipe: {name}", EXIT_ARGS)
    return path


def resolved_dirs(args: argparse.Namespace) -> tuple[Path, Path, Path]:
    cache = safe_path(args.cache_dir, "cache directory")
    runs = safe_path(args.runs_dir, "runs directory")
    state = safe_path(args.state_dir, "state directory")
    return cache, runs, state


def validate_bundle(profile: dict[str, Any] | None = None) -> dict[str, Any]:
    upstream = read_json(BUNDLE / "upstream.lock.json")
    image = read_json(BUNDLE / "image" / "image.lock.json")
    assets = read_json(BUNDLE / "assets.lock.json")
    series = read_json(BUNDLE / "patches" / "paper-intent" / "series.json")
    errors: list[str] = []
    warnings: list[str] = []
    commit = upstream.get("commit", "")
    archive_hash = upstream.get("archive_sha256", "")
    if not SHA40.fullmatch(str(commit)):
        errors.append("upstream commit is not a full 40-character SHA")
    if not re.fullmatch(r"[0-9a-f]{64}", str(archive_hash)):
        errors.append("upstream archive hash is not SHA-256")
    base = str(image.get("base_image", ""))
    if not re.search(r"@sha256:[0-9a-f]{64}$", base):
        errors.append("base OCI image is not digest-pinned")
    for asset_id, asset in assets.get("assets", {}).items():
        if not SAFE_NAME.fullmatch(asset_id):
            errors.append(f"unsafe asset id: {asset_id!r}")
        if not SHA40.fullmatch(str(asset.get("revision", ""))):
            errors.append(f"asset {asset_id} is not pinned to a full commit revision")
    known = set(assets.get("assets", {}))
    for set_name, members in assets.get("sets", {}).items():
        unknown = set(members) - known
        if unknown:
            errors.append(f"asset set {set_name} contains unknown assets: {sorted(unknown)}")
    built = image.get("built_images", {})
    if profile is not None and not built.get(profile["name"]):
        warnings.append(f"no immutable built-image digest is recorded for profile {profile['name']}")
    if profile is not None and profile.get("source_mode") == "paper-intent" and series.get("status") != "validated":
        warnings.append(f"paper-intent patch series status is {series.get('status')!r}")
    return {
        "status": "FAIL" if errors else ("WARN" if warnings else "PASS"),
        "errors": errors,
        "warnings": warnings,
        "upstream_commit": commit,
        "base_image": base,
        "assets": len(assets.get("assets", {})),
    }


def image_ref(args: argparse.Namespace, state: Path, *, planning: bool = False) -> tuple[str, bool]:
    if getattr(args, "image", None):
        return args.image, "@sha256:" in args.image
    lock = read_json(BUNDLE / "image" / "image.lock.json")
    locked = lock.get("built_images", {}).get(args.profile)
    if locked:
        return str(locked), True
    bootstrap_state = state / "bootstrap-state.json"
    if bootstrap_state.is_file():
        recorded = read_json(bootstrap_state).get("image", {})
        if recorded.get("ref"):
            return str(recorded["ref"]), bool(recorded.get("immutable", False))
    if planning:
        sha = read_json(BUNDLE / "upstream.lock.json")["commit"][:8]
        return f"energy-repro:{args.profile}-{sha}", False
    raise ReproError(
        "No built image is available. Run `./repro bootstrap --build-image` or pass --image registry/name@sha256:…",
        EXIT_PREREQ,
    )


def verify_local_image(
    args: argparse.Namespace,
    state: Path,
    ref: str,
    *,
    check_recorded: bool = True,
    expected_build_context_sha256: str | None = None,
) -> dict[str, Any]:
    inspected = run_capture([args.runtime, "image", "inspect", ref], check=False)
    if inspected.returncode:
        raise ReproError(
            f"OCI image is not present locally or cannot be inspected: {ref}",
            EXIT_PREREQ,
            (inspected.stderr or inspected.stdout).strip(),
        )
    try:
        records = json.loads(inspected.stdout)
        record = records[0]
        image_id = str(record["Id"])
        labels = record.get("Config", {}).get("Labels", {}) or {}
        repo_digests = record.get("RepoDigests", []) or []
    except (json.JSONDecodeError, IndexError, KeyError, TypeError) as exc:
        raise ReproError(f"Could not parse OCI image inspection for {ref}", EXIT_POLICY) from exc
    upstream = read_json(BUNDLE / "upstream.lock.json")
    dependency_lock_sha256 = sha256_file(BUNDLE / "locks" / "core-py310-cu124.txt")
    errors: list[str] = []
    if labels.get("org.opencontainers.image.revision") != upstream["commit"]:
        errors.append("image source revision label does not match upstream.lock.json")
    if labels.get("io.energy-repro.source-sha256") != upstream["archive_sha256"]:
        errors.append("image source archive label does not match upstream.lock.json")
    if labels.get("io.energy-repro.dependency-lock-sha256") != dependency_lock_sha256:
        errors.append("image dependency lock label does not match the current bundle")
    context_label = str(labels.get("io.energy-repro.build-context-sha256") or "")
    if not re.fullmatch(r"[0-9a-f]{64}", context_label):
        errors.append("image has no valid build-context SHA-256 label")
    if "@sha256:" in ref and ref not in repo_digests:
        errors.append(f"requested immutable ref is absent from RepoDigests: {ref}")
    bootstrap_state = state / "bootstrap-state.json"
    if check_recorded:
        if not bootstrap_state.is_file():
            errors.append("bootstrap state is missing; run `./repro bootstrap` before using an image")
        else:
            recorded_state = read_json(bootstrap_state)
            previous = recorded_state.get("image", {})
            if previous.get("ref") == ref and previous.get("id") and previous["id"] != image_id:
                errors.append("mutable image tag no longer points at the image recorded by bootstrap")
            source_path = recorded_state.get("source", {}).get("path")
            if not source_path or not Path(source_path).is_dir():
                errors.append("bootstrap source cache is missing")
            else:
                current_context = build_context_manifest(Path(source_path))["context_sha256"]
                if previous.get("build_context_sha256") != current_context:
                    errors.append("bootstrap image context does not match the current bundle/source")
                expected_build_context_sha256 = current_context
            current_fingerprints = {
                "dockerfile_sha256": sha256_file(BUNDLE / "image" / "Dockerfile"),
                "dependency_lock_sha256": dependency_lock_sha256,
                "assets_lock_sha256": sha256_file(BUNDLE / "assets.lock.json"),
                "profile_sha256": sha256_file(profile_path(args.profile)),
            }
            if recorded_state.get("fingerprints") != current_fingerprints:
                errors.append("bootstrap fingerprints do not match the current bundle")
    if expected_build_context_sha256 and context_label != expected_build_context_sha256:
        errors.append("image build-context label does not match the verified build context")
    if errors:
        raise ReproError("OCI image provenance verification failed", EXIT_POLICY, errors)
    return {
        "ref": ref,
        "id": image_id,
        "repo_digests": repo_digests,
        "immutable": "@sha256:" in ref,
        "labels": {
            "org.opencontainers.image.revision": labels.get("org.opencontainers.image.revision"),
            "io.energy-repro.source-sha256": labels.get("io.energy-repro.source-sha256"),
            "io.energy-repro.build-context-sha256": labels.get("io.energy-repro.build-context-sha256"),
            "io.energy-repro.dependency-lock-sha256": labels.get("io.energy-repro.dependency-lock-sha256"),
        },
    }


def docker_mount(source: Path, target: str, readonly: bool = False) -> list[str]:
    source = source.resolve()
    if "," in str(source):
        raise ReproError(f"Docker mount paths containing commas are unsupported: {source}", EXIT_POLICY)
    spec = f"type=bind,src={source},dst={target}"
    if readonly:
        spec += ",readonly"
    return ["--mount", spec]


def container_identity_args() -> list[str]:
    """Keep bind-mounted outputs owned by the invoking host user."""
    if not hasattr(os, "getuid") or not hasattr(os, "getgid"):
        raise ReproError("This capsule currently requires a POSIX host user identity", EXIT_PREREQ)
    return [
        "--user",
        f"{os.getuid()}:{os.getgid()}",
        "--env",
        "HOME=/tmp",
        "--env",
        "XDG_CACHE_HOME=/tmp/.cache",
    ]


def runtime_cache_args(cache: Path) -> list[str]:
    return [
        *docker_mount(cache / "runtime", "/cache/runtime", False),
        "--env",
        "HOME=/cache/runtime/home",
        "--env",
        "XDG_CACHE_HOME=/cache/runtime/xdg",
        "--env",
        "HF_HOME=/cache/runtime/huggingface",
        "--env",
        "HF_HUB_CACHE=/cache/runtime/huggingface/hub",
        "--env",
        "HF_DATASETS_CACHE=/cache/runtime/datasets",
        "--env",
        "HF_XET_CACHE=/cache/runtime/xet",
        "--env",
        "TORCH_HOME=/cache/runtime/torch",
    ]


def host_probe(profile: dict[str, Any], runtime: str) -> dict[str, Any]:
    checks: list[dict[str, Any]] = []
    runtime_result = run_capture([runtime, "version"], check=False)
    checks.append(
        {
            "name": "container_runtime",
            "status": "PASS" if runtime_result.returncode == 0 else "FAIL",
            "detail": (runtime_result.stderr or runtime_result.stdout).strip()[:400],
        }
    )
    gpu_result = run_capture(
        [
            "nvidia-smi",
            "--query-gpu=index,uuid,name,memory.total,power.limit",
            "--format=csv,noheader,nounits",
        ],
        check=False,
    )
    gpu_rows: list[dict[str, Any]] = []
    if gpu_result.returncode == 0:
        for line in gpu_result.stdout.splitlines():
            parts = [item.strip() for item in line.split(",")]
            if len(parts) >= 5:
                try:
                    gpu_rows.append(
                        {
                            "index": int(parts[0]),
                            "uuid": parts[1],
                            "name": parts[2],
                            "memory_mib": float(parts[3]),
                            "power_limit_watts": float(parts[4]),
                        }
                    )
                except ValueError:
                    pass
    hardware = profile["hardware"]
    gpu_errors: list[str] = []
    if len(gpu_rows) != int(hardware["gpu_count"]):
        gpu_errors.append(f"expected {hardware['gpu_count']} visible GPU, found {len(gpu_rows)}")
    for gpu in gpu_rows:
        if hardware["gpu_name_contains"] not in gpu["name"]:
            gpu_errors.append(f"GPU name does not contain {hardware['gpu_name_contains']!r}: {gpu['name']}")
        if gpu["memory_mib"] < float(hardware["min_vram_mib"]):
            gpu_errors.append(f"GPU memory is {gpu['memory_mib']} MiB, below {hardware['min_vram_mib']}")
        expected_power = hardware.get("power_limit_watts")
        if expected_power is not None and abs(gpu["power_limit_watts"] - float(expected_power)) > 1.0:
            gpu_errors.append(f"GPU power limit is {gpu['power_limit_watts']} W, expected {expected_power} W")
    checks.append(
        {
            "name": "gpu",
            "status": "FAIL" if gpu_errors or gpu_result.returncode else "PASS",
            "detail": gpu_errors or (gpu_result.stderr.strip() if gpu_result.returncode else gpu_rows),
        }
    )
    process_result = run_capture(
        [
            "nvidia-smi",
            "--query-compute-apps=pid,process_name,used_memory",
            "--format=csv,noheader,nounits",
        ],
        check=False,
    )
    processes = [
        line.strip()
        for line in process_result.stdout.splitlines()
        if line.strip() and "No running processes" not in line
    ]
    checks.append(
        {
            "name": "gpu_compute_processes",
            "status": "FAIL" if process_result.returncode or processes else "PASS",
            "detail": processes if processes else (process_result.stderr.strip() if process_result.returncode else []),
        }
    )
    ram_gib = 0.0
    try:
        if Path("/proc/meminfo").is_file():
            match = re.search(r"^MemTotal:\s+(\d+)\s+kB", Path("/proc/meminfo").read_text(), re.M)
            if match:
                ram_gib = int(match.group(1)) / 1024 / 1024
        elif sys.platform == "darwin":
            ram_gib = int(run_capture(["sysctl", "-n", "hw.memsize"]).stdout.strip()) / 1024**3
    except (OSError, ValueError, ReproError):
        pass
    checks.append(
        {
            "name": "ram",
            "status": "PASS" if ram_gib >= float(hardware["min_ram_gib"]) else "FAIL",
            "detail": {"observed_gib": round(ram_gib, 2), "minimum_gib": hardware["min_ram_gib"]},
        }
    )
    rapl = Path(profile["energy_overrides"]["rapl_root"])
    if hardware.get("require_rapl"):
        rapl_ok = rapl.is_dir() and os.access(rapl, os.R_OK)
        checks.append({"name": "rapl", "status": "PASS" if rapl_ok else "FAIL", "detail": str(rapl)})
    return {
        "system": {
            "platform": platform.platform(),
            "machine": platform.machine(),
            "cpu": platform.processor(),
            "ram_gib": round(ram_gib, 2),
        },
        "gpus": gpu_rows,
        "checks": checks,
        "status": "FAIL" if any(item["status"] == "FAIL" for item in checks) else "PASS",
    }


def assert_gpu_idle() -> None:
    result = run_capture(
        [
            "nvidia-smi",
            "--query-compute-apps=pid,process_name,used_memory",
            "--format=csv,noheader,nounits",
        ],
        check=False,
    )
    if result.returncode:
        raise ReproError(
            "Could not query existing GPU compute processes",
            EXIT_PREREQ,
            (result.stderr or result.stdout).strip(),
        )
    processes = [
        line.strip()
        for line in result.stdout.splitlines()
        if line.strip() and "No running processes" not in line
    ]
    if processes:
        raise ReproError(
            "GPU already has compute processes; energy measurements would be contaminated",
            EXIT_POLICY,
            processes,
        )


def command_doctor(args: argparse.Namespace) -> dict[str, Any]:
    profile = read_json(profile_path(args.profile))
    static = validate_bundle(profile)
    result: dict[str, Any] = {
        "command": "doctor",
        "profile": args.profile,
        "mode": args.mode,
        "static": static,
    }
    if args.dry_run:
        result.update(
            {
                "status": static["status"],
                "dry_run": True,
                "planned_probes": [
                    f"{args.runtime} version",
                    "nvidia-smi GPU identity, memory, power, ECC and process checks",
                    "host CPU, RAM, RAPL and disk checks",
                    "container CUDA/PyTorch/NVML probe" if args.mode == "runtime" else "container probe skipped",
                ],
                "deferred_checks": ["container runtime", "GPU", "driver", "host memory", "RAPL", "runtime imports"],
            }
        )
        if static["errors"]:
            raise ReproError("Static bundle validation failed", EXIT_POLICY, result)
        return result
    if static["errors"]:
        raise ReproError("Static bundle validation failed", EXIT_POLICY, result)
    if args.mode == "static":
        result["status"] = static["status"]
        return result
    host = host_probe(profile, args.runtime)
    result["host"] = host
    if args.mode == "runtime" and host["status"] == "PASS":
        _, _, state = resolved_dirs(args)
        ref, immutable = image_ref(args, state)
        image_verification = verify_local_image(args, state, ref)
        probe = runtime_probe_argv(args, ref)
        probe_result = run_capture(probe, check=False)
        try:
            detail: Any = json.loads(probe_result.stdout) if probe_result.stdout.strip() else probe_result.stderr.strip()
        except json.JSONDecodeError:
            detail = (probe_result.stdout + probe_result.stderr).strip()
        result["runtime"] = {
            "status": "PASS" if probe_result.returncode == 0 else "FAIL",
            "image": ref,
            "image_immutable": immutable,
            "image_verification": image_verification,
            "detail": detail,
        }
    result["status"] = (
        "FAIL"
        if host["status"] == "FAIL" or result.get("runtime", {}).get("status") == "FAIL"
        else ("WARN" if static["warnings"] else "PASS")
    )
    if result["status"] == "FAIL":
        raise ReproError("Host/runtime profile checks failed", EXIT_PREREQ, result)
    return result


def git_archive_sha(repo: Path) -> str:
    try:
        process = subprocess.Popen(
            ["git", "archive", "--format=tar", "HEAD"],
            cwd=repo,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except FileNotFoundError as exc:
        raise ReproError("git is not installed", EXIT_PREREQ) from exc
    assert process.stdout is not None
    digest = hashlib.sha256()
    for chunk in iter(lambda: process.stdout.read(1024 * 1024), b""):
        digest.update(chunk)
    stderr = process.stderr.read().decode("utf-8", "replace") if process.stderr else ""
    returncode = process.wait()
    if returncode:
        raise ReproError(f"git archive failed: {stderr.strip()}", EXIT_EXEC)
    return digest.hexdigest()


def verify_source(repo: Path, lock: dict[str, Any]) -> dict[str, Any]:
    if not (repo / ".git").is_dir():
        raise ReproError(f"Source cache is not a git checkout: {repo}", EXIT_POLICY)
    head = run_capture(["git", "rev-parse", "HEAD"], cwd=repo).stdout.strip()
    dirty = run_capture(["git", "status", "--porcelain"], cwd=repo).stdout.strip()
    remote = run_capture(["git", "remote", "get-url", "origin"], cwd=repo).stdout.strip()
    archive = git_archive_sha(repo)
    errors: list[str] = []
    if head != lock["commit"]:
        errors.append(f"HEAD is {head}, expected {lock['commit']}")
    if dirty:
        errors.append("source checkout is dirty")
    if normalize_repo(remote) != normalize_repo(lock["repository"]):
        errors.append(f"origin is {remote!r}, expected {lock['repository']!r}")
    if archive != lock["archive_sha256"]:
        errors.append(f"archive SHA-256 is {archive}, expected {lock['archive_sha256']}")
    if errors:
        raise ReproError("Pinned source verification failed", EXIT_POLICY, errors)
    return {"path": str(repo), "commit": head, "archive_sha256": archive, "origin": remote, "dirty": False}


def build_context_manifest(source: Path) -> dict[str, Any]:
    roots = {
        "image/Dockerfile": BUNDLE / "image" / "Dockerfile",
        ".dockerignore": BUNDLE / ".dockerignore",
        "locks/core-py310-cu124.txt": BUNDLE / "locks" / "core-py310-cu124.txt",
    }
    for path in sorted((BUNDLE / "tools").glob("*.py")):
        roots[f"tools/{path.name}"] = path
    for path in sorted(source.rglob("*")):
        if ".git" in path.relative_to(source).parts:
            continue
        info = path.lstat()
        if stat.S_ISLNK(info.st_mode):
            raise ReproError(f"Upstream build source contains a symlink: {path}", EXIT_POLICY)
        if stat.S_ISREG(info.st_mode):
            roots[f"upstream/{path.relative_to(source).as_posix()}"] = path
        elif not stat.S_ISDIR(info.st_mode):
            raise ReproError(f"Upstream build source contains a special file: {path}", EXIT_POLICY)
    files = {
        relative: {
            "sha256": sha256_file(path),
            "executable": bool(path.stat().st_mode & stat.S_IXUSR),
        }
        for relative, path in sorted(roots.items())
    }
    value = {"schema": "energy-repro/build-context/v1", "files": files}
    value["context_sha256"] = sha256_bytes(canonical_bytes(value))
    return value


def prepare_build_context(cache: Path, source: Path) -> tuple[Path, dict[str, Any]]:
    manifest = build_context_manifest(source)
    root = cache / "build-contexts"
    destination = root / manifest["context_sha256"][:16]
    marker_name = ".energy-build-context.json"
    if destination.exists():
        marker = read_json(destination / marker_name)
        if marker != manifest:
            raise ReproError(f"Cached build context marker differs from expected content: {destination}", EXIT_POLICY)
        for relative, expected in manifest["files"].items():
            path = destination / relative
            if not path.is_file() or path.is_symlink() or sha256_file(path) != expected["sha256"]:
                raise ReproError(f"Cached build context file is missing or modified: {path}", EXIT_POLICY)
        return destination, manifest
    root.mkdir(parents=True, exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=".context-", dir=root))
    try:
        for relative in manifest["files"]:
            if relative.startswith("upstream/"):
                source_path = source / relative.removeprefix("upstream/")
            else:
                source_path = BUNDLE / relative
            target = temporary / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source_path, target, follow_symlinks=False)
        atomic_json(temporary / marker_name, manifest)
        os.replace(temporary, destination)
    finally:
        if temporary.exists():
            shutil.rmtree(temporary)
    return destination, manifest


def command_bootstrap(args: argparse.Namespace) -> dict[str, Any]:
    if args.offline and args.build_image:
        raise ReproError(
            "Offline image builds are not supported: pip/base-image cache completeness cannot be proven. "
            "Reuse an already verified image or build once while online.",
            EXIT_POLICY,
        )
    profile = read_json(profile_path(args.profile))
    static = validate_bundle(profile)
    if static["errors"]:
        raise ReproError("Static bundle validation failed", EXIT_POLICY, static)
    cache, runs, state = resolved_dirs(args)
    lock = read_json(BUNDLE / "upstream.lock.json")
    source = cache / "source" / lock["commit"]
    tag = f"energy-repro:{args.profile}-{lock['commit'][:8]}"
    plan = {
        "command": "bootstrap",
        "profile": args.profile,
        "offline": args.offline,
        "source": str(source),
        "source_commit": lock["commit"],
        "source_archive_sha256": lock["archive_sha256"],
        "build_image": args.build_image,
        "image_tag": tag if args.build_image else None,
        "requested_image": args.image,
        "directories": [str(cache), str(runs), str(state)],
    }
    if args.dry_run:
        plan["dry_run"] = True
        plan["status"] = "PLANNED"
        plan["deferred_checks"] = ["network/source cache", "container build", "GPU runtime"]
        return plan
    for directory in (cache, runs, state, source.parent):
        directory.mkdir(parents=True, exist_ok=True)
    lock_path = state / "bootstrap.lock"
    with lock_path.open("w") as lock_file:
        try:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise ReproError("Another bootstrap process holds the lock", EXIT_CONFLICT) from exc
        if not source.exists():
            if args.offline:
                raise ReproError(f"Offline bootstrap cannot find cached source: {source}", EXIT_PREREQ)
            temporary = Path(tempfile.mkdtemp(prefix=".source-", dir=source.parent))
            try:
                run_capture(["git", "clone", "--no-checkout", lock["repository"], str(temporary)])
                run_capture(["git", "checkout", "--detach", lock["commit"]], cwd=temporary)
                verify_source(temporary, lock)
                os.replace(temporary, source)
            finally:
                if temporary.exists():
                    shutil.rmtree(temporary)
        source_info = verify_source(source, lock)
        context_manifest = build_context_manifest(source)
        dependency_lock_sha256 = sha256_file(BUNDLE / "locks" / "core-py310-cu124.txt")
        image_info: dict[str, Any] = {"ref": None, "immutable": False, "id": None}
        previous_state_path = state / "bootstrap-state.json"
        if previous_state_path.is_file() and not args.build_image:
            previous_state = read_json(previous_state_path)
            if previous_state.get("profile") == args.profile and previous_state.get("runtime") == args.runtime:
                image_info = previous_state.get("image", image_info)
        if args.build_image:
            context, context_manifest = prepare_build_context(cache, source)
            build = [
                args.runtime,
                "build",
                "--platform",
                "linux/amd64",
                "--pull",
                "--build-arg",
                f"ENERGY_BUILD_CONTEXT_SHA256={context_manifest['context_sha256']}",
                "--build-arg",
                f"ENERGY_DEPENDENCY_LOCK_SHA256={dependency_lock_sha256}",
                "--file",
                str(context / "image" / "Dockerfile"),
                "--tag",
                tag,
                str(context),
            ]
            run_capture(build)
            image_info = verify_local_image(
                args,
                state,
                tag,
                check_recorded=False,
                expected_build_context_sha256=context_manifest["context_sha256"],
            )
            image_info["build_context_sha256"] = context_manifest["context_sha256"]
        elif not image_info.get("ref"):
            locked = read_json(BUNDLE / "image" / "image.lock.json").get("built_images", {}).get(args.profile)
            candidate = args.image or locked
            if candidate:
                if not args.offline and "@sha256:" in candidate:
                    run_capture([args.runtime, "pull", candidate])
                image_info = verify_local_image(
                    args,
                    state,
                    candidate,
                    check_recorded=False,
                    expected_build_context_sha256=context_manifest["context_sha256"],
                )
                image_info["build_context_sha256"] = context_manifest["context_sha256"]
            elif args.offline:
                raise ReproError(
                    "Offline bootstrap has no previously recorded or explicitly supplied local image",
                    EXIT_PREREQ,
                )
        if not args.build_image and image_info.get("ref"):
            image_info = verify_local_image(
                args,
                state,
                str(image_info["ref"]),
                check_recorded=False,
                expected_build_context_sha256=context_manifest["context_sha256"],
            )
            image_info["build_context_sha256"] = context_manifest["context_sha256"]
        state_value = {
            "schema": "energy-repro/bootstrap-state/v1",
            "created_at": utc_now(),
            "profile": args.profile,
            "runtime": args.runtime,
            "source": source_info,
            "image": image_info,
            "fingerprints": {
                "dockerfile_sha256": sha256_file(BUNDLE / "image" / "Dockerfile"),
                "dependency_lock_sha256": sha256_file(BUNDLE / "locks" / "core-py310-cu124.txt"),
                "assets_lock_sha256": sha256_file(BUNDLE / "assets.lock.json"),
                "profile_sha256": sha256_file(profile_path(args.profile)),
            },
        }
        atomic_json(state / "bootstrap-state.json", state_value)
    return {"status": "PASS", **plan, "source_verification": source_info, "image": image_info}


def common_container_env(
    run_id: str | None = None,
    *,
    wandb_mode: str = "offline",
) -> list[str]:
    if wandb_mode not in {"offline", "disabled"}:
        raise ReproError(f"Unsupported W&B mode: {wandb_mode!r}", EXIT_POLICY)
    values = {
        "CUDA_VISIBLE_DEVICES": "0",
        "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1",
        "WANDB_MODE": wandb_mode,
        "TZ": "UTC",
        "OMP_NUM_THREADS": "16",
        "MKL_NUM_THREADS": "16",
        "OPENBLAS_NUM_THREADS": "16",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
    }
    if run_id:
        values["WANDB_DIR"] = f"/runs/{run_id}/wandb"
