    for key, value in values.items():
        output.extend(["-e", f"{key}={value}"])
    return output


def command_fetch_assets(args: argparse.Namespace) -> dict[str, Any]:
    lock = read_json(BUNDLE / "assets.lock.json")
    if args.asset_set not in lock.get("sets", {}):
        raise ReproError(f"Unknown asset set: {args.asset_set}", EXIT_ARGS)
    cache, _, state = resolved_dirs(args)
    ref, immutable = image_ref(args, state, planning=args.dry_run)
    asset_root = cache / "assets"
    command = [
        args.runtime,
        "run",
        "--rm",
        "--network=none" if args.offline or args.verify_only else "--network=bridge",
        *container_identity_args(),
        *runtime_cache_args(cache),
        *docker_mount(BUNDLE / "assets.lock.json", "/inputs/assets.lock.json", True),
        *docker_mount(asset_root, "/cache/assets", False),
    ]
    if "HF_TOKEN" in os.environ and not args.dry_run:
        command.extend(["-e", "HF_TOKEN"])
    command.extend(
        [
            ref,
            "python",
            "/opt/energy-repro/tools/fetch_assets.py",
            "--lock-file",
            "/inputs/assets.lock.json",
            "--cache-dir",
            "/cache/assets",
            "--set",
            args.asset_set,
            "--json",
        ]
    )
    if args.offline:
        command.append("--offline")
    if args.verify_only:
        command.append("--verify-only")
    plan = {
        "command": "fetch-assets",
        "asset_set": args.asset_set,
        "assets": lock["sets"][args.asset_set],
        "expected_bytes": sum(
            int(lock["assets"][asset_id].get("expected_bytes") or 0)
            for asset_id in lock["sets"][args.asset_set]
        ),
        "cache": str(asset_root),
        "image": ref,
        "image_immutable": immutable,
        "argv": command,
    }
    if args.dry_run:
        return {"status": "PLANNED", "dry_run": True, **plan, "deferred_checks": ["image", "disk", "asset snapshots"]}
    asset_root.mkdir(parents=True, exist_ok=True)
    (cache / "runtime").mkdir(parents=True, exist_ok=True)
    image_verification = verify_local_image(args, state, ref)
    result = run_capture(command, check=False)
    try:
        detail: Any = json.loads(result.stdout) if result.stdout.strip() else result.stderr.strip()
    except json.JSONDecodeError:
        detail = (result.stdout + result.stderr).strip()
    if result.returncode:
        raise ReproError("Asset fetch/verification failed", EXIT_PREREQ, {"plan": plan, "detail": detail})
    return {"status": "PASS", **plan, "image_verification": image_verification, "result": detail}


def deterministic_plan(
    profile: dict[str, Any],
    recipe: dict[str, Any] | None,
    stage: str,
    seed: int,
    attempt: int,
    image: str,
) -> tuple[dict[str, Any], str]:
    upstream = read_json(BUNDLE / "upstream.lock.json")
    pilot = recipe.get("pilot", {}) if recipe else {}
    if not isinstance(pilot, dict):
        raise ReproError("Recipe pilot metadata must be a JSON object", EXIT_POLICY)
    scientific = {
        "schema": "energy-repro/plan/v1",
        "profile": profile["name"],
        "compliance_label": profile["compliance_label"],
        "recipe": recipe["name"] if recipe else "telemetry",
        "pipeline": recipe["pipeline"] if recipe else "prerun",
        "result_classification": (
            recipe.get("classification", profile["compliance_label"])
            if recipe
            else profile["compliance_label"]
        ),
        "pilot": bool(pilot.get("enabled")),
        "stage": stage,
        "seed": seed,
        "attempt": attempt,
        "upstream_commit": upstream["commit"],
        "upstream_archive_sha256": upstream["archive_sha256"],
        "asset_lock_sha256": sha256_file(BUNDLE / "assets.lock.json"),
        "dependency_lock_sha256": sha256_file(BUNDLE / "locks" / "core-py310-cu124.txt"),
        "profile_sha256": sha256_file(profile_path(profile["name"])),
        "recipe_sha256": sha256_file(recipe_path(recipe["name"])) if recipe else None,
        "image": image,
        "known_scientific_conflicts": read_json(BUNDLE / "patches" / "paper-intent" / "series.json")[
            "known_scientific_conflicts"
        ],
    }
    plan_hash = sha256_bytes(canonical_bytes(scientific))
    name = recipe["name"] if recipe else "telemetry-smoke"
    run_id = f"{name}__{profile['name']}__seed-{seed}__attempt-{attempt:03d}__{plan_hash[:8]}"
    scientific["plan_sha256"] = plan_hash
    scientific["run_id"] = run_id
    return scientific, run_id


