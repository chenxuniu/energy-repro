def command_run(args: argparse.Namespace) -> dict[str, Any]:
    profile = read_json(profile_path(args.profile))
    blocked = profile.get("blocked_stages", {})
    if args.stage in blocked:
        raise ReproError(f"{args.profile} blocks stage {args.stage!r}: {blocked[args.stage]}", EXIT_POLICY)
    if args.stage not in profile.get("runnable_stages", []):
        raise ReproError(f"{args.profile} does not allow stage {args.stage!r}", EXIT_POLICY)
    recipe = read_json(recipe_path(args.recipe))
    allowed_profiles = recipe.get("allowed_profiles")
    if allowed_profiles is not None:
        if not isinstance(allowed_profiles, list) or not all(
            isinstance(item, str) for item in allowed_profiles
        ):
            raise ReproError(
                f"Recipe {args.recipe!r} has an invalid allowed_profiles policy",
                EXIT_POLICY,
            )
        if args.profile not in allowed_profiles:
            raise ReproError(
                f"Recipe {args.recipe!r} is allowed only with profiles: "
                + ", ".join(sorted(allowed_profiles)),
                EXIT_POLICY,
            )
    allowed_stages = recipe.get("allowed_stages")
    if allowed_stages is not None:
        if not isinstance(allowed_stages, list) or not all(
            isinstance(item, str) for item in allowed_stages
        ):
            raise ReproError(
                f"Recipe {args.recipe!r} has an invalid allowed_stages policy",
                EXIT_POLICY,
            )
        if args.stage not in allowed_stages:
            raise ReproError(
                f"Recipe {args.recipe!r} allows only stages: "
                + ", ".join(sorted(allowed_stages)),
                EXIT_POLICY,
            )
    pilot = recipe.get("pilot", {})
    if not isinstance(pilot, dict):
        raise ReproError(
            f"Recipe {args.recipe!r} has invalid pilot metadata",
            EXIT_POLICY,
        )
    if pilot.get("enabled"):
        if (
            recipe.get("classification") != PILOT_CLASSIFICATION
            or pilot.get("classification") != PILOT_CLASSIFICATION
        ):
            raise ReproError(
                f"Pilot recipe {args.recipe!r} is missing the required non-paper classification",
                EXIT_POLICY,
            )
    cache, runs, state_dir = resolved_dirs(args)
    ref, immutable = image_ref(args, state_dir, planning=args.dry_run)
    plan, run_id = deterministic_plan(profile, recipe, args.stage, args.seed, args.attempt, ref)
    run_root = runs / run_id
    resolve_command = resolver_argv(args, ref, cache, runs, run_id, recipe)
    execute_command = stage_argv(args, ref, cache, runs, run_id, recipe)
    result = {
        "command": "run",
        "profile": args.profile,
        "recipe": args.recipe,
        "stage": args.stage,
        "run_id": run_id,
        "run_root": str(run_root),
        "image": ref,
        "image_immutable": immutable,
        "plan": plan,
        "resolver_argv": resolve_command,
        "execution_argv": execute_command,
        "known_deviations_acknowledged": bool(args.ack_known_deviations),
        "result_classification": plan["result_classification"],
        "pilot": plan["pilot"],
    }
    if args.dry_run:
        deferred = ["image", "GPU", "assets", "derived stage inputs"]
        if profile.get("requires_known_deviations_ack") and not args.ack_known_deviations:
            deferred.append("explicit --ack-known-deviations required for execution")
        return {"status": "PLANNED", "dry_run": True, **result, "deferred_checks": deferred}
    if profile.get("requires_known_deviations_ack") and not args.ack_known_deviations:
        raise ReproError(
            f"{args.profile} is {profile['compliance_label']}; pass --ack-known-deviations after reading README.md",
            EXIT_POLICY,
        )
    existing = existing_run_result(run_root, plan)
    if existing:
        return existing
    assert_gpu_idle()
    image_verification = verify_local_image(args, state_dir, ref)
    for directory in (cache / "assets", cache / "derived", cache / "runtime", runs):
        directory.mkdir(parents=True, exist_ok=True)
    run_root.mkdir(parents=True)
    for child in ("resolved", "logs", "energy", "outputs", "wandb"):
        (run_root / child).mkdir()
    provenance = execution_provenance(image_verification)
    atomic_json(run_root / "resolved" / "execution-provenance.json", provenance)
    atomic_json(run_root / "plan.json", plan)
    manifest = initial_manifest(plan, profile, "planned", execute_command)
    manifest["image_verification"] = image_verification
    manifest["execution_provenance"] = provenance
    manifest["timestamps"]["created_at"] = utc_now()
    atomic_json(run_root / "manifest.json", manifest)
    write_run_state(run_root, "planned")
    lock_path = run_root / ".stage.lock"
    with lock_path.open("w") as lock_file:
        try:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise ReproError(f"Run is locked: {run_id}", EXIT_CONFLICT) from exc
        probe = run_capture(runtime_probe_argv(args, ref), check=False)
        if probe.returncode:
            manifest["failure"] = {
                "phase": "runtime-probe",
                "subprocess_exit_code": probe.returncode,
                "detail": redact((probe.stdout + probe.stderr).strip()[:16000]),
            }
            finalize_run_manifest(run_root, manifest, "failed", EXIT_PREREQ, phase="runtime-probe")
            raise ReproError("Runtime GPU probe failed before formal stage", EXIT_PREREQ, probe.stdout + probe.stderr)
        try:
            hardware = json.loads(probe.stdout)
        except json.JSONDecodeError:
            hardware = {"raw": probe.stdout.strip()}
        resolve = run_capture(resolve_command, check=False)
        if resolve.returncode:
            manifest["hardware"] = hardware
            manifest["failure"] = {
                "phase": "resolve-config",
                "subprocess_exit_code": resolve.returncode,
                "detail": redact((resolve.stdout + resolve.stderr).strip()[:16000]),
            }
            finalize_run_manifest(run_root, manifest, "failed", EXIT_PREREQ, phase="resolve-config")
            raise ReproError(
                "Config resolution or asset verification failed",
                EXIT_PREREQ,
                (resolve.stdout + resolve.stderr).strip(),
            )
        metadata_path = run_root / "resolved" / f"{args.stage}.metadata.json"
        derived_lock_file: Any = None
        production: dict[str, Any] | None = None
        if args.stage in {"preprocess", "teacher"}:
            try:
                derived_lock_file, fingerprint = acquire_derived_lock(metadata_path, cache)
            except ReproError as exc:
                manifest["hardware"] = hardware
                manifest["failure"] = {"phase": "derived-lock", "detail": str(exc)}
                finalize_run_manifest(run_root, manifest, "failed", exc.code, phase="derived-lock")
                raise
            try:
                production = inspect_derived_production(
                    metadata_path,
                    cache,
                    recipe,
                    args.stage,
                    fingerprint,
                )
            except ReproError as exc:
                derived_lock_file.close()
                manifest["hardware"] = hardware
                manifest["failure"] = {"phase": "derived-preflight", "detail": str(exc)}
                finalize_run_manifest(run_root, manifest, "failed", exc.code, phase="derived-preflight")
                raise
            if production["action"] == "block":
                derived_lock_file.close()
                manifest["hardware"] = hardware
                manifest["failure"] = {
                    "phase": "derived-preflight",
                    "detail": (
                        "A partial, invalid, or mismatched derived artifact already exists. "
                        "It was not overwritten; move it to quarantine or change the recipe namespace."
                    ),
                    "errors": production["errors"],
                }
                finalize_run_manifest(run_root, manifest, "failed", EXIT_POLICY, phase="derived-preflight")
                raise ReproError(
                    "Refusing to overwrite an incomplete or invalid derived artifact",
                    EXIT_POLICY,
                    production["errors"],
                )

        manifest["state"] = "running"
        manifest["hardware"] = hardware
        manifest["timestamps"]["started_at"] = utc_now()
        manifest["config_resolution"] = str(metadata_path)
        manifest["execution_mode"] = "derived-cache-hit" if production and production["action"] == "reuse" else "executed"
        atomic_json(run_root / "manifest.json", manifest)
        write_run_state(run_root, "running", started_at=manifest["timestamps"]["started_at"])
        if production and production["action"] == "reuse":
            manifest["derived_reuse"] = production["targets"]
            finalize_run_manifest(run_root, manifest, "succeeded", 0, execution_mode="derived-cache-hit")
            derived_lock_file.close()
            return {
                "status": "NOOP",
                **result,
                "reason": "validated derived cache hit; upstream producer was not launched",
                "manifest": str(run_root / "manifest.json"),
            }
        derived_receipts: list[dict[str, Any]] = []
        try:
            returncode = execute_logged(execute_command, run_root / "logs" / f"{args.stage}.log")
            if returncode == 0 and args.stage in {"preprocess", "teacher"}:
                try:
                    derived_receipts = publish_derived_receipts(
                        run_root / "resolved" / f"{args.stage}.metadata.json",
                        cache,
                        plan,
                    )
                except Exception as exc:
                    returncode = exc.code if isinstance(exc, ReproError) else EXIT_EXEC
                    manifest["receipt_error"] = redact(str(exc))
        except KeyboardInterrupt:
            manifest["failure"] = {"phase": "execution", "detail": "interrupted by user"}
            finalize_run_manifest(run_root, manifest, "interrupted", 130, phase="execution")
            raise
        except OSError as exc:
            manifest["failure"] = {"phase": "execution", "detail": redact(str(exc))}
            finalize_run_manifest(run_root, manifest, "failed", EXIT_EXEC, phase="execution")
            raise ReproError("Could not launch or record experiment stage", EXIT_EXEC, str(exc)) from exc
        finally:
            if derived_lock_file is not None:
                derived_lock_file.close()
        final_state, wrapper_exit_code = execution_outcome(returncode)
        manifest["derived_receipts"] = derived_receipts
        finalize_run_manifest(run_root, manifest, final_state, returncode)
    if returncode:
        message = "Experiment stage was interrupted" if final_state == "interrupted" else "Experiment stage failed"
        raise ReproError(message, wrapper_exit_code, {"run_id": run_id, "exit_code": returncode})
    return {"status": "PASS", **result, "manifest": str(run_root / "manifest.json")}


def parse_sync_target(raw: str) -> Path:
    parsed = urlparse(raw)
    if parsed.scheme in ("", "file"):
        if parsed.scheme == "file" and parsed.netloc not in ("", "localhost"):
            raise ReproError("file:// sync targets must be local", EXIT_ARGS)
        value = unquote(parsed.path) if parsed.scheme == "file" else raw
        return safe_path(value, "sync target")
    raise ReproError(
        f"Unsupported sync scheme {parsed.scheme!r}; use a mounted persistent path or file:///…",
        EXIT_ARGS,
    )


def iter_regular_files(root: Path) -> Iterable[tuple[Path, Path]]:
    for path in sorted(root.rglob("*")):
        relative = path.relative_to(root)
        if relative.parts[:2] == ("sync", "receipts"):
            continue
        info = path.lstat()
        if stat.S_ISLNK(info.st_mode):
            raise ReproError(f"Refusing to sync symlink: {relative}", EXIT_POLICY)
        if stat.S_ISREG(info.st_mode):
            yield path, relative
        elif not stat.S_ISDIR(info.st_mode):
            raise ReproError(f"Refusing to sync special file: {relative}", EXIT_POLICY)


def command_sync(args: argparse.Namespace) -> dict[str, Any]:
    if not SAFE_NAME.fullmatch(args.run_id):
        raise ReproError(f"Invalid run ID: {args.run_id!r}", EXIT_ARGS)
    _, runs, _ = resolved_dirs(args)
    source = runs / args.run_id
    if not source.is_dir():
        raise ReproError(f"Run does not exist: {source}", EXIT_PREREQ)
    target_root = parse_sync_target(args.to)
    target = target_root / args.run_id
    if under(target, source) or target.resolve() == source.resolve():
        raise ReproError("Sync target must not be inside the source run", EXIT_POLICY)
    state_path = source / "state.json"
    manifest_path = source / "manifest.json"
    source_state = (
        read_json(state_path).get("state")
        if state_path.is_file()
        else (read_json(manifest_path).get("state") if manifest_path.is_file() else "unknown")
    )
    stage_lock_path = source / ".stage.lock"
    stage_lock_file: Any = None
    active = source_state in {"planned", "running"}
    if stage_lock_path.is_file():
        stage_lock_file = stage_lock_path.open("r")
        try:
            fcntl.flock(stage_lock_file.fileno(), fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            active = True
            stage_lock_file.close()
            stage_lock_file = None
    files = list(iter_regular_files(source))
    plan = {
        "command": "sync",
        "run_id": args.run_id,
        "source": str(source),
        "target": str(target),
        "files": len(files),
        "bytes": sum(path.stat().st_size for path, _ in files),
        "verify": True,
        "requested_verify_flag": bool(args.verify),
        "source_state": source_state,
        "snapshot_kind": "partial" if active else "complete",
        "delete": False,
        "follow_symlinks": False,
    }
    if args.dry_run:
        if stage_lock_file is not None:
            stage_lock_file.close()
        return {"status": "PLANNED", "dry_run": True, **plan}
    try:
        target.mkdir(parents=True, exist_ok=True)
        copied = 0
        snapshot_files: list[dict[str, Any]] = []
        for source_file, relative in files:
            before = source_file.stat()
            source_hash = sha256_file(source_file)
            after_hash = source_file.stat()
            if (
                before.st_size != after_hash.st_size
                or before.st_mtime_ns != after_hash.st_mtime_ns
            ):
                raise ReproError(
                    f"Source changed while hashing {relative}; rerun sync for a stable snapshot",
                    EXIT_CONFLICT,
                )
            destination = target / relative
            if destination.is_symlink():
                raise ReproError(f"Refusing to overwrite destination symlink: {destination}", EXIT_POLICY)
            if destination.exists() and not destination.is_file():
                raise ReproError(f"Refusing to overwrite non-file destination: {destination}", EXIT_POLICY)
            if destination.is_file() and sha256_file(destination) == source_hash:
                snapshot_files.append(
                    {"path": relative.as_posix(), "bytes": before.st_size, "sha256": source_hash}
                )
                continue
            destination.parent.mkdir(parents=True, exist_ok=True)
            descriptor, temporary = tempfile.mkstemp(prefix=f".{destination.name}.", dir=destination.parent)
            os.close(descriptor)
            try:
                shutil.copy2(source_file, temporary, follow_symlinks=False)
                if sha256_file(Path(temporary)) != source_hash:
                    raise ReproError(f"Checksum failed while syncing {relative}", EXIT_EXEC)
                after_copy = source_file.stat()
                if (
                    after_hash.st_size != after_copy.st_size
                    or after_hash.st_mtime_ns != after_copy.st_mtime_ns
                ):
                    raise ReproError(
                        f"Source changed while copying {relative}; rerun sync for a stable snapshot",
                        EXIT_CONFLICT,
                    )
                os.replace(temporary, destination)
            finally:
                try:
                    os.unlink(temporary)
                except FileNotFoundError:
                    pass
            copied += 1
            snapshot_files.append(
                {"path": relative.as_posix(), "bytes": before.st_size, "sha256": source_hash}
            )
        for item in snapshot_files:
            destination = target / item["path"]
            if (
                not destination.is_file()
                or destination.is_symlink()
                or destination.stat().st_size != item["bytes"]
                or sha256_file(destination) != item["sha256"]
            ):
                raise ReproError(f"Target verification failed for {item['path']}", EXIT_EXEC)
        receipt = {
            "schema": "energy-repro/sync-receipt/v1",
            "status": "partial" if active else "complete",
            "run_id": args.run_id,
            "source_state": source_state,
            "completed_at": utc_now(),
            "source_manifest_sha256": sha256_file(manifest_path) if manifest_path.is_file() else None,
            "target": str(target),
            "copied_files": copied,
            "total_files": len(files),
            "verified": True,
            "files": snapshot_files,
        }
        atomic_json(target / ".energy-repro-sync.json", receipt)
        receipt_name = sha256_bytes(str(target).encode("utf-8"))[:16] + ".json"
        atomic_json(source / "sync" / "receipts" / receipt_name, receipt)
        return {
            "status": "PARTIAL" if active else "PASS",
            **plan,
            "copied_files": copied,
            "receipt": receipt,
        }
    finally:
        if stage_lock_file is not None:
            stage_lock_file.close()


def verify_manifest(run_root: Path, manifest: dict[str, Any], deep: bool) -> dict[str, Any]:
    errors: list[str] = []
    checked = 0
    if manifest.get("schema") != "energy-repro/manifest/v1":
        errors.append("unsupported or missing manifest schema")
    if manifest.get("run_id") != run_root.name:
        errors.append("manifest run_id does not match its directory")
    if manifest.get("state") not in {"planned", "running", "succeeded", "failed", "interrupted"}:
        errors.append("manifest has an invalid state")
    plan = manifest.get("plan")
    plan_path = run_root / "plan.json"
    if not isinstance(plan, dict) or not plan_path.is_file():
        errors.append("manifest and plan.json are required")
    else:
        try:
            saved_plan = read_json(plan_path)
        except ReproError as exc:
            errors.append(str(exc))
        else:
            if saved_plan != plan:
                errors.append("manifest plan does not match plan.json")
        if plan.get("run_id") != manifest.get("run_id"):
            errors.append("plan run_id does not match manifest")
        plan_payload = dict(plan)
        claimed_plan_hash = str(plan_payload.pop("plan_sha256", ""))
        plan_payload.pop("run_id", None)
        actual_plan_hash = sha256_bytes(canonical_bytes(plan_payload))
        if claimed_plan_hash != actual_plan_hash:
            errors.append("plan_sha256 does not match canonical plan content")
        recipe_name = str(plan.get("recipe") or "")
        run_name = "telemetry-smoke" if recipe_name == "telemetry" else recipe_name
        try:
            expected_run_id = (
                f"{run_name}__{plan['profile']}__seed-{int(plan['seed'])}__"
                f"attempt-{int(plan['attempt']):03d}__{actual_plan_hash[:8]}"
            )
        except (KeyError, TypeError, ValueError):
            errors.append("plan is missing valid run identity fields")
        else:
            if expected_run_id != manifest.get("run_id"):
                errors.append("run_id is not bound to the canonical plan")
        upstream = read_json(BUNDLE / "upstream.lock.json")
        expected_bindings = {
            "upstream_commit": upstream["commit"],
            "upstream_archive_sha256": upstream["archive_sha256"],
            "asset_lock_sha256": sha256_file(BUNDLE / "assets.lock.json"),
            "dependency_lock_sha256": sha256_file(BUNDLE / "locks" / "core-py310-cu124.txt"),
        }
        for key, expected in expected_bindings.items():
            if plan.get(key) != expected:
                errors.append(f"plan {key} does not match the current bundle")
        profile_name = plan.get("profile")
        if isinstance(profile_name, str):
            try:
                expected_profile_hash = sha256_file(profile_path(profile_name))
            except ReproError as exc:
                errors.append(str(exc))
            else:
                if plan.get("profile_sha256") != expected_profile_hash:
                    errors.append("plan profile_sha256 does not match the current bundle")
        if recipe_name and recipe_name != "telemetry":
            try:
                expected_recipe_hash = sha256_file(recipe_path(recipe_name))
            except ReproError as exc:
                errors.append(str(exc))
            else:
                if plan.get("recipe_sha256") != expected_recipe_hash:
                    errors.append("plan recipe_sha256 does not match the current bundle")
    state_path = run_root / "state.json"
    if not state_path.is_file():
        errors.append("state.json is missing")
    else:
        try:
            run_state = read_json(state_path)
        except ReproError as exc:
            errors.append(str(exc))
        else:
            if run_state.get("schema") != "energy-repro/run-state/v1":
                errors.append("state.json has an invalid schema")
            if run_state.get("state") != manifest.get("state"):
                errors.append("state.json and manifest state differ")
            if run_state.get("exit_code") != manifest.get("exit_code"):
                errors.append("state.json and manifest exit_code differ")
    artifacts = manifest.get("artifacts")
    if not isinstance(artifacts, list):
        errors.append("manifest artifacts must be a list")
        artifacts = []
    seen: set[str] = set()
    for item in artifacts:
        if not isinstance(item, dict):
            errors.append("manifest contains a non-object artifact")
            continue
        if item.get("type") != "file":
            errors.append(f"non-regular artifact recorded: {item.get('path')}")
            continue
        relative = item.get("path", "")
        if not isinstance(relative, str) or not relative or relative in seen:
            errors.append(f"invalid or duplicate artifact path: {relative!r}")
            continue
        seen.add(relative)
        path = run_root / relative
        if not under(path, run_root) or not path.is_file() or path.is_symlink():
            errors.append(f"missing or unsafe artifact: {relative}")
            continue
        if path.stat().st_size != item.get("bytes"):
            errors.append(f"size mismatch: {relative}")
            continue
        expected = item.get("sha256")
        if expected or deep:
            actual = sha256_file(path)
            checked += 1
            if expected and actual != expected:
                errors.append(f"SHA-256 mismatch: {relative}")
    actual_inventory = artifact_inventory(run_root)
    if artifacts != actual_inventory:
        expected_paths = {str(item.get("path")) for item in artifacts if isinstance(item, dict)}
        actual_paths = {str(item.get("path")) for item in actual_inventory}
        missing = sorted(expected_paths - actual_paths)
        unrecorded = sorted(actual_paths - expected_paths)
        if missing:
            errors.append(f"recorded artifacts missing from disk: {missing}")
        if unrecorded:
            errors.append(f"unrecorded artifacts exist on disk: {unrecorded}")
        if not missing and not unrecorded:
            errors.append("artifact inventory metadata differs from the manifest")
    return {"status": "FAIL" if errors else "PASS", "checked_hashes": checked, "errors": errors}


def command_manifest(args: argparse.Namespace) -> dict[str, Any]:
    if not SAFE_NAME.fullmatch(args.run_id):
        raise ReproError(f"Invalid run ID: {args.run_id!r}", EXIT_ARGS)
    _, runs, _ = resolved_dirs(args)
    run_root = runs / args.run_id
    path = run_root / "manifest.json"
    if not path.is_file():
        raise ReproError(f"Manifest does not exist: {path}", EXIT_PREREQ)
    manifest = read_json(path)
    result: dict[str, Any] = {"status": "PASS", "path": str(path), "manifest": manifest}
    if args.verify:
        verification = verify_manifest(run_root, manifest, args.deep)
        result["verification"] = verification
        if verification["errors"]:
            raise ReproError("Manifest verification failed", EXIT_POLICY, result)
    return result


def command_export_results(args: argparse.Namespace) -> dict[str, Any]:
    if not SAFE_NAME.fullmatch(args.run_id):
        raise ReproError(f"Invalid run ID: {args.run_id!r}", EXIT_ARGS)
    _, runs, _ = resolved_dirs(args)
    run_root = runs / args.run_id
    output = safe_path(args.output, "public result directory")
    archive = (
        safe_path(args.archive, "public result archive")
        if args.archive is not None
        else None
    )
    command = [
        sys.executable,
        str(BUNDLE / "tools" / "export_results.py"),
        str(run_root),
        "--output",
        str(output),
        "--max-file-bytes",
        str(args.max_file_bytes),
    ]
    if archive is not None:
        command.extend(["--archive", str(archive)])
    plan = {
        "command": "export-results",
        "run_id": args.run_id,
        "run_root": str(run_root),
        "output": str(output),
        "archive": str(archive) if archive is not None else None,
        "max_file_bytes": args.max_file_bytes,
        "source_verification": "full-manifest-inventory-and-sha256",
        "public_policy": (
            "sanitized metadata, compact metrics/energy/log summaries; "
            "no models, checkpoints, datasets, assets, W&B files, secrets, "
            "host identity, GPU UUIDs, or absolute paths"
        ),
        "argv": command,
    }
    if args.dry_run:
        return {"status": "PLANNED", "dry_run": True, **plan}
    if not run_root.is_dir():
        raise ReproError(f"Run does not exist: {run_root}", EXIT_PREREQ)
    result = run_capture(command, check=False)
    detail_text = (result.stdout or result.stderr).strip()
    try:
        detail: Any = json.loads(detail_text)
    except json.JSONDecodeError:
        detail = detail_text
    if result.returncode:
        raise ReproError(
            "Public result export failed",
            EXIT_POLICY,
            {"plan": plan, "detail": detail},
        )
    return {"status": "PASS", **plan, "result": detail}


def common_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument(
        "--profile",
        default=os.environ.get("ENERGY_REPRO_PROFILE", "h100-portable"),
        choices=("upstream-exact", "paper-strict", "h100-portable"),
    )
    common.add_argument(
        "--cache-dir",
        default=os.environ.get("ENERGY_REPRO_CACHE", str(BUNDLE / ".cache")),
    )
    common.add_argument(
        "--runs-dir",
        default=os.environ.get("ENERGY_REPRO_RUNS", str(BUNDLE / "runs")),
    )
    common.add_argument(
        "--state-dir",
        default=os.environ.get("ENERGY_REPRO_STATE", str(BUNDLE / ".state")),
    )
    common.add_argument(
        "--runtime",
        default=os.environ.get("ENERGY_REPRO_RUNTIME", "docker"),
        choices=("docker",),
    )
    common.add_argument("--image", help="OCI image ref; prefer registry/name@sha256:<digest>")
    common.add_argument("--dry-run", action="store_true")
    common.add_argument("--json", action="store_true")
    return common


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="repro",
        description="Reproducibility capsule for StellarLuminosity/Energy @ a3b76e8",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    common = common_parser()

    doctor = subparsers.add_parser("doctor", parents=[common], help="Read-only environment validation")
    doctor.add_argument("--mode", choices=("static", "host", "runtime"), default="runtime")
    doctor.set_defaults(handler=command_doctor)

    bootstrap = subparsers.add_parser("bootstrap", parents=[common], help="Prepare pinned source and image")
    bootstrap.add_argument("--offline", action="store_true")
    bootstrap.add_argument("--build-image", action="store_true")
    bootstrap.set_defaults(handler=command_bootstrap)

    fetch = subparsers.add_parser("fetch-assets", parents=[common], help="Fetch immutable Hub snapshots")
    fetch.add_argument("--set", dest="asset_set", required=True)
    fetch.add_argument("--offline", action="store_true")
    fetch.add_argument("--verify-only", action="store_true")
    fetch.set_defaults(handler=command_fetch_assets)

    smoke = subparsers.add_parser("smoke", parents=[common], help="Run a short H100 telemetry smoke")
    smoke.add_argument("--kind", choices=("telemetry", "pipeline"), default="telemetry")
    smoke.add_argument("--recipe")
    smoke.add_argument("--attempt", type=int, default=1)
    smoke.set_defaults(handler=command_smoke)

    run = subparsers.add_parser("run", parents=[common], help="Run one explicit experiment stage")
    run.add_argument("--recipe", required=True)
    run.add_argument("--stage", required=True, choices=("preprocess", "teacher", "student", "eval", "all"))
    run.add_argument("--seed", type=int, default=42)
    run.add_argument("--attempt", type=int, default=1)
    run.add_argument("--ack-known-deviations", action="store_true")
    run.set_defaults(handler=command_run)

    sync = subparsers.add_parser("sync", parents=[common], help="Incrementally copy a run to persistent storage")
    sync.add_argument("run_id")
    sync.add_argument("--to", required=True)
    sync.add_argument(
        "--verify",
        action="store_true",
        help="Compatibility flag; SHA-256 verification is always enabled",
    )
    sync.set_defaults(handler=command_sync)

    manifest = subparsers.add_parser("manifest", parents=[common], help="Display or verify a run manifest")
    manifest.add_argument("run_id")
    manifest.add_argument("--verify", action="store_true")
    manifest.add_argument("--deep", action="store_true")
    manifest.set_defaults(handler=command_manifest)

    export = subparsers.add_parser(
        "export-results",
        parents=[common],
        help="Create a sanitized compact public result bundle",
    )
    export.add_argument("run_id")
    export.add_argument("--output", required=True)
    export.add_argument("--archive")
    export.add_argument(
        "--max-file-bytes",
        type=int,
        default=1024 * 1024,
        help="Maximum source file size eligible for public content (default: 1 MiB)",
    )
    export.set_defaults(handler=command_export_results)
    return parser


def validate_numbers(args: argparse.Namespace) -> None:
    for name in ("attempt",):
        if hasattr(args, name) and getattr(args, name) < 1:
            raise ReproError(f"--{name} must be at least 1", EXIT_ARGS)
    if hasattr(args, "seed") and args.seed < 0:
        raise ReproError("--seed must be non-negative", EXIT_ARGS)
    if hasattr(args, "max_file_bytes") and args.max_file_bytes < 1:
        raise ReproError("--max-file-bytes must be positive", EXIT_ARGS)


def main(argv: list[str] | None = None) -> int:
    os.umask(0o027)
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        validate_numbers(args)
        result = args.handler(args)
        emit(args, result)
        return 0
    except ReproError as exc:
        payload = {"status": "ERROR", "code": exc.code, "error": str(exc)}
        if exc.details is not None:
            payload["details"] = exc.details
        emit(args, payload)
        return exc.code
    except KeyboardInterrupt:
        emit(args, {"status": "INTERRUPTED", "code": 130})
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
