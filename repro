def artifact_inventory(run_root: Path, deep: bool = True) -> list[dict[str, Any]]:
    output: list[dict[str, Any]] = []
    if not run_root.is_dir():
        return output
    for path in sorted(run_root.rglob("*")):
        relative = path.relative_to(run_root).as_posix()
        if relative in {"manifest.json", "state.json"} or relative.startswith("sync/receipts/"):
            continue
        info = path.lstat()
        if stat.S_ISLNK(info.st_mode):
            output.append({"path": relative, "type": "symlink-rejected"})
        elif stat.S_ISREG(info.st_mode):
            item: dict[str, Any] = {"path": relative, "type": "file", "bytes": info.st_size}
            if deep or info.st_size <= 16 * 1024 * 1024:
                item["sha256"] = sha256_file(path)
            else:
                item["sha256"] = None
            output.append(item)
    return output


def directory_stats(root: Path) -> dict[str, Any]:
    if not root.is_dir():
        raise ReproError(f"Expected derived artifact directory was not created: {root}", EXIT_EXEC)
    payload_files: list[tuple[str, Path]] = []
    total_bytes = 0
    for path in sorted(root.rglob("*")):
        info = path.lstat()
        if stat.S_ISLNK(info.st_mode):
            raise ReproError(f"Derived artifact contains a symlink: {path}", EXIT_POLICY)
        if stat.S_ISREG(info.st_mode):
            payload_files.append((path.relative_to(root).as_posix(), path))
        elif not stat.S_ISDIR(info.st_mode):
            raise ReproError(f"Derived artifact contains a special file: {path}", EXIT_POLICY)
    if not payload_files:
        raise ReproError(f"Derived artifact directory is empty: {root}", EXIT_EXEC)
    tree = hashlib.sha256()
    for relative, path in sorted(payload_files):
        content_sha256 = sha256_file(path)
        size = path.stat().st_size
        total_bytes += size
        record = {"path": relative, "sha256": content_sha256, "size": size}
        tree.update(json.dumps(record, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("utf-8"))
        tree.update(b"\n")
    return {
        "file_count": len(payload_files),
        "total_bytes": total_bytes,
        "tree_sha256": tree.hexdigest(),
    }


def container_cache_path_to_host(raw: str, cache: Path) -> Path:
    container_root = Path("/cache")
    candidate = Path(raw)
    try:
        relative = candidate.relative_to(container_root)
    except ValueError as exc:
        raise ReproError(f"Resolved derived path is outside /cache: {raw}", EXIT_POLICY) from exc
    host = (cache / relative).resolve()
    if not under(host, cache):
        raise ReproError(f"Resolved derived path escapes host cache: {raw}", EXIT_POLICY)
    return host


def publish_derived_receipts(
    metadata_path: Path,
    cache: Path,
    plan: dict[str, Any],
) -> list[dict[str, Any]]:
    metadata = read_json(metadata_path)
    fingerprint = metadata.get("derived_fingerprint")
    if not re.fullmatch(r"[0-9a-f]{64}", str(fingerprint or "")):
        raise ReproError("Resolved metadata has no valid derived fingerprint", EXIT_POLICY)
    receipts: list[dict[str, Any]] = []
    for artifact, spec in sorted(metadata.get("derived_artifacts", {}).items()):
        if not spec.get("target_for_stage"):
            continue
        artifact_path = container_cache_path_to_host(str(spec["path"]), cache)
        receipt_path = container_cache_path_to_host(str(spec["receipt_path"]), cache)
        stats = directory_stats(artifact_path)
        receipt = {
            "schema": "energy-repro/derived-receipt/v1",
            "artifact": artifact,
            "fingerprint": fingerprint,
            "status": "succeeded",
            "tree_hash_algorithm": "sha256-jsonl-posix-path-size-content-sha256-v1",
            "created_at": utc_now(),
            "producer": {
                "run_id": plan["run_id"],
                "plan_sha256": plan["plan_sha256"],
                "stage": plan["stage"],
                "upstream_commit": plan["upstream_commit"],
                "asset_lock_sha256": plan["asset_lock_sha256"],
                "execution_provenance": metadata.get("execution_provenance"),
            },
            "payload": stats,
        }
        atomic_json(receipt_path, receipt)
        receipts.append({"artifact": artifact, "path": str(receipt_path), **stats})
    if plan["stage"] in {"preprocess", "teacher"} and not receipts:
        raise ReproError(f"Stage {plan['stage']} produced no receipt-target artifacts", EXIT_EXEC)
    return receipts


def live_derived_status(
    artifact: str,
    spec: dict[str, Any],
    fingerprint: str,
    cache: Path,
    expected_provenance: dict[str, Any] | None = None,
) -> dict[str, Any]:
    artifact_path = container_cache_path_to_host(str(spec["path"]), cache)
    receipt_path = container_cache_path_to_host(str(spec["receipt_path"]), cache)
    artifact_exists = artifact_path.exists() or artifact_path.is_symlink()
    receipt_exists = receipt_path.exists() or receipt_path.is_symlink()
    base = {
        "artifact": artifact,
        "path": str(artifact_path),
        "receipt_path": str(receipt_path),
    }
    if not artifact_exists and not receipt_exists:
        return {**base, "status": "absent"}
    if artifact_path.is_symlink() or receipt_path.is_symlink():
        return {**base, "status": "invalid", "error": "artifact or receipt is a symlink"}
    if not artifact_path.is_dir() or not receipt_path.is_file():
        return {
            **base,
            "status": "invalid",
            "error": "artifact and receipt must either both be absent or both be complete",
        }
    try:
        receipt = read_json(receipt_path)
        stats = directory_stats(artifact_path)
    except ReproError as exc:
        return {**base, "status": "invalid", "error": str(exc)}
    expected_fields = {
        "schema": "energy-repro/derived-receipt/v1",
        "artifact": artifact,
        "fingerprint": fingerprint,
        "status": "succeeded",
        "tree_hash_algorithm": "sha256-jsonl-posix-path-size-content-sha256-v1",
    }
    mismatches = [
        key for key, expected in expected_fields.items() if receipt.get(key) != expected
    ]
    expected_payload = {
        "file_count": stats["file_count"],
        "total_bytes": stats["total_bytes"],
        "tree_sha256": stats["tree_sha256"],
    }
    if receipt.get("payload") != expected_payload:
        mismatches.append("payload")
    if (
        expected_provenance is not None
        and receipt.get("producer", {}).get("execution_provenance")
        != expected_provenance
    ):
        mismatches.append("producer.execution_provenance")
    if mismatches:
        return {
            **base,
            "status": "invalid",
            "error": f"receipt mismatch in: {', '.join(mismatches)}",
        }
    return {**base, "status": "valid", "payload": expected_payload, "receipt": receipt}


def acquire_derived_lock(metadata_path: Path, cache: Path) -> tuple[Any, str]:
    metadata = read_json(metadata_path)
    fingerprint = str(metadata.get("derived_fingerprint") or "")
    if not re.fullmatch(r"[0-9a-f]{64}", fingerprint):
        raise ReproError("Resolved metadata has no valid derived fingerprint", EXIT_POLICY)
    lock_path = cache / "derived" / ".locks" / f"{fingerprint}.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    lock_file = lock_path.open("w")
    try:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as exc:
        lock_file.close()
        raise ReproError(
            f"Another run is producing derived artifacts for fingerprint {fingerprint[:16]}",
            EXIT_CONFLICT,
        ) from exc
    return lock_file, fingerprint


def inspect_derived_production(
    metadata_path: Path,
    cache: Path,
    recipe: dict[str, Any],
    stage: str,
    fingerprint: str,
) -> dict[str, Any]:
    metadata = read_json(metadata_path)
    if metadata.get("derived_fingerprint") != fingerprint:
        raise ReproError("Derived fingerprint changed while acquiring its lock", EXIT_POLICY)
    targets = [
        live_derived_status(
            name,
            spec,
            fingerprint,
            cache,
            metadata.get("execution_provenance"),
        )
        for name, spec in sorted(metadata.get("derived_artifacts", {}).items())
        if spec.get("target_for_stage")
    ]
    if not targets:
        raise ReproError(f"Producer stage {stage!r} has no declared derived target", EXIT_POLICY)
    if all(item["status"] == "valid" for item in targets):
        return {"action": "reuse", "targets": targets}
    invalid = [item for item in targets if item["status"] == "invalid"]
    if invalid:
        return {"action": "block", "targets": targets, "errors": invalid}
    if recipe.get("pipeline") == "kd" and stage == "teacher":
        workspace_spec = metadata.get("derived_artifacts", {}).get("logprob_cache", {})
        workspace = container_cache_path_to_host(str(workspace_spec.get("path", "")), cache)
        if workspace.exists() or workspace.is_symlink():
            return {
                "action": "block",
                "targets": targets,
                "errors": [
                    {
                        "artifact": "logprob_cache",
                        "path": str(workspace),
                        "status": "invalid",
                        "error": "partial KD chunk workspace exists without a valid final receipt",
                    }
                ],
            }
    return {"action": "execute", "targets": targets}


